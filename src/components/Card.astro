---
interface Props {
	title: string;
	body: string;
	icon?: string;
}

const { title, body, icon } = Astro.props;
---

<div class="card glass">
	{icon && <div class="icon">{icon}</div>}
	<h3>{title}</h3>
	<p>{body}</p>
</div>

<style>
	.card {
		padding: 40px;
		border-radius: 24px;
		transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.card:hover {
		border-color: var(--sdai-primary);
		transform: translateY(-8px);
		box-shadow: 0 15px 45px rgba(0, 163, 255, 0.15);
		background: rgba(0, 163, 255, 0.05);
	}

	h3 {
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
	}

	p {
		color: var(--sdai-text-dim);
		line-height: 1.6;
		font-size: 1rem;
		margin: 0;
	}

	.icon {
		font-size: 2rem;
		margin-bottom: 8px;
	}
</style>
