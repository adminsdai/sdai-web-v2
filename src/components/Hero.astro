---
---
<section class="hero" id="inicio">
  <div class="hero-grid"></div>
  <div class="hero-glow glow-a"></div>
  <div class="hero-glow glow-b"></div>
  <div class="container hero-wrap">
    <div class="hero-copy">
      <span class="eyebrow">CONSULTORÍA ESTRATÉGICA · SDAI CHILE</span>
      <h1>LA CONFIANZA <span>SE GOBIERNA.</span></h1>
      <p class="lead">Ayudamos a las organizaciones a gobernar la transformación regulatoria y tecnológica, convirtiendo <strong>obligaciones, riesgos y decisiones en capacidades organizacionales estratégicas.</strong></p>
      <p class="belief">Nuestra mirada comienza antes de la tecnología.</p>
      <div class="hero-actions">
        <a href="#mirada" class="btn-premium">Conozca nuestra mirada</a>
        <a href="#contacto" class="btn-outline">Conversemos</a>
      </div>
      <div class="domains" aria-label="Ámbitos SDAI">
        <span>Gobernanza</span><i></i><span>Privacidad</span><i></i><span>Ciberseguridad</span><i></i><span>Datos</span><i></i><span>IA Responsable</span>
      </div>
    </div>
    <div class="hero-brand" aria-hidden="true">
      <div class="brand-orbit orbit-one"></div>
      <div class="brand-orbit orbit-two"></div>
      <img src="/brand/sdai-evolution-b_2.png" alt="" />
      <div class="brand-caption">SDAI TRUST ARCHITECTURE™</div>
    </div>
  </div>
</section>

<style>
.hero{min-height:100vh;display:flex;align-items:center;position:relative;overflow:hidden;padding:150px 0 92px;background:radial-gradient(circle at 78% 36%,rgba(37,99,235,.14),transparent 34%),radial-gradient(circle at 18% 18%,rgba(6,182,212,.10),transparent 32%),linear-gradient(145deg,#020817 0%,#031126 48%,#020617 100%)}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(56,189,248,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(56,189,248,.045) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.75),transparent 92%)}
.hero-glow{position:absolute;border-radius:999px;filter:blur(80px);opacity:.23}.glow-a{width:420px;height:420px;background:#0ea5e9;right:8%;top:18%}.glow-b{width:300px;height:300px;background:#2563eb;right:28%;bottom:-12%}
.hero-wrap{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(340px,.85fr);gap:70px;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:10px;color:#38bdf8;font-size:.78rem;letter-spacing:.22em;font-weight:800;margin-bottom:26px}.eyebrow:before{content:"";width:34px;height:1px;background:#d7a84b}
h1{font-size:clamp(3.2rem,7.2vw,6.8rem);line-height:.93;letter-spacing:-.055em;max-width:920px;margin-bottom:28px}h1 span{display:block;background:linear-gradient(95deg,#22d3ee 0%,#3b82f6 68%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 0 34px rgba(37,99,235,.12)}
.lead{font-size:clamp(1.08rem,1.8vw,1.32rem);line-height:1.72;color:rgba(248,250,252,.74);max-width:760px;margin:0 0 22px}.lead strong{color:#fff;font-weight:600}.belief{font-family:'Sora',sans-serif;font-size:clamp(1.12rem,2vw,1.45rem);font-weight:700;color:#fff;margin:0 0 36px;padding-left:18px;border-left:2px solid #d7a84b}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:44px}.btn-outline{padding:17px 31px;border-radius:100px;border:1px solid rgba(148,163,184,.3);color:#fff;text-decoration:none;font-weight:700;background:rgba(255,255,255,.02);transition:.25s}.btn-outline:hover{border-color:#38bdf8;background:rgba(56,189,248,.07);transform:translateY(-2px)}
.domains{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:rgba(226,232,240,.62);font-size:.73rem;letter-spacing:.07em;text-transform:uppercase}.domains i{display:block;width:4px;height:4px;background:#d7a84b;border-radius:50%}
.hero-brand{position:relative;min-height:520px;display:flex;align-items:center;justify-content:center}.hero-brand img{position:relative;z-index:3;width:min(92%,470px);height:auto;filter:drop-shadow(0 0 30px rgba(56,189,248,.26))}.brand-orbit{position:absolute;border:1px solid rgba(56,189,248,.17);border-radius:50%}.orbit-one{width:440px;height:440px}.orbit-two{width:540px;height:540px;border-style:dashed;opacity:.55}.brand-caption{position:absolute;bottom:12px;z-index:4;font-size:.68rem;letter-spacing:.24em;color:rgba(148,163,184,.52)}
@media(max-width:960px){.hero{padding-top:130px}.hero-wrap{grid-template-columns:1fr;text-align:center}.hero-copy{display:flex;flex-direction:column;align-items:center}.belief{border-left:0;border-top:1px solid #d7a84b;padding:14px 0 0}.hero-brand{min-height:330px}.hero-brand img{width:min(70vw,330px)}.orbit-one{width:300px;height:300px}.orbit-two{width:360px;height:360px}.domains{justify-content:center}}
@media(max-width:620px){.hero{padding:118px 0 68px}.hero-wrap{gap:28px}.hero-brand{min-height:270px}.hero-brand img{width:240px}.orbit-one{width:240px;height:240px}.orbit-two{width:290px;height:290px}.domains{font-size:.66rem}.hero-actions{justify-content:center}}
</style>
