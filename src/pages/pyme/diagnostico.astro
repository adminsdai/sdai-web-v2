---
import Layout from '../../layouts/Layout.astro';

const contextQuestions = [
{id:'workers',label:'¿Tiene trabajadores?',type:'bool'},{id:'clients',label:'¿Mantiene información de clientes?',type:'bool'},{id:'cctv',label:'¿Utiliza CCTV o cámaras de seguridad?',type:'bool'},{id:'critical_excel',label:'¿Utiliza Excel para información crítica del negocio?',type:'bool'},{id:'erp',label:'¿Utiliza ERP, DMS u otro sistema de gestión?',type:'bool'},{id:'whatsapp',label:'¿Utiliza WhatsApp para comunicarse con clientes?',type:'bool'},{id:'ecommerce',label:'¿Vende o agenda servicios por Internet?',type:'bool'},{id:'cloud',label:'¿Utiliza servicios cloud como Microsoft 365 o Google Workspace?',type:'tri'},{id:'it_provider',label:'¿Tiene proveedor TI externo?',type:'bool'},{id:'ai',label:'¿Utiliza herramientas de inteligencia artificial?',type:'tri'},{id:'backups',label:'¿Realiza respaldos de información?',type:'tri'},{id:'offline',label:'¿Podría operar un día completo sin sus sistemas principales?',type:'operability'}];

const controls = [
{id:'IA-01',domain:'IA',q:'¿La empresa sabe qué herramientas de IA utilizan sus trabajadores y para qué?',action:'Levantar un inventario simple de herramientas y casos de uso de IA.'},
{id:'IA-02',domain:'IA',q:'¿Existen reglas claras sobre qué información de la empresa o clientes puede ingresarse en herramientas de IA?',action:'Definir reglas mínimas de uso seguro de IA y datos.',critical:true},
{id:'IA-03',domain:'IA',q:'¿Una persona revisa los resultados de IA antes de utilizarlos en trabajos o decisiones relevantes?',action:'Definir revisión humana proporcional al impacto del uso de IA.'},
{id:'IA-04',domain:'IA',q:'¿Existe alguien responsable de autorizar, revisar o resolver dudas sobre nuevos usos de IA?',action:'Asignar un responsable para usos y decisiones relacionadas con IA.'},
{id:'DAT-01',domain:'DATOS',q:'¿La empresa sabe cuáles son sus datos más importantes y dónde se encuentran?',action:'Construir un inventario mínimo de información crítica.'},
{id:'DAT-02',domain:'DATOS',q:'¿Está claro quién puede crear, modificar, consultar y eliminar información importante?',action:'Definir responsables y accesos sobre información crítica.'},
{id:'DAT-03',domain:'DATOS',q:'¿Existe alguna forma de detectar información incorrecta, duplicada, incompleta o desactualizada?',action:'Definir controles mínimos de calidad para los datos más importantes.'},
{id:'DAT-04',domain:'DATOS',q:'¿Existe un criterio para decidir cuánto tiempo conservar información y cuándo eliminarla?',action:'Definir criterios básicos de conservación y eliminación.'},
{id:'PRI-01',domain:'PRIVACIDAD',q:'¿La empresa sabe qué datos personales mantiene y en qué sistemas, archivos, cámaras o aplicaciones se encuentran?',action:'Crear un inventario inicial de datos personales y tratamientos.',critical:true},
{id:'PRI-02',domain:'PRIVACIDAD',q:'¿Puede explicar para qué utiliza esos datos personales y por qué los necesita?',action:'Identificar finalidad y fundamento de los tratamientos relevantes.'},
{id:'PRI-03',domain:'PRIVACIDAD',q:'¿Las personas reciben información clara acerca de cómo serán utilizados sus datos?',action:'Preparar información mínima y comprensible de privacidad.'},
{id:'PRI-04',domain:'PRIVACIDAD',q:'Si una persona solicita acceder, corregir, eliminar u oponerse al uso de sus datos, ¿está claro quién debe actuar y qué hacer?',action:'Crear un canal y procedimiento básico para solicitudes de titulares.',critical:true},
{id:'CYB-01',domain:'CIBERSEGURIDAD',q:'¿La empresa conoce los computadores, sistemas, aplicaciones, servicios cloud y otros activos que necesita proteger?',action:'Inventariar activos tecnológicos esenciales.',critical:true},
{id:'CYB-02',domain:'CIBERSEGURIDAD',q:'¿Cada persona tiene sus propios accesos y existe una práctica para crearlos, revisarlos y eliminarlos?',action:'Revisar cuentas, privilegios, MFA y proceso de altas/bajas.',critical:true},
{id:'CYB-03',domain:'CIBERSEGURIDAD',q:'¿Equipos y sistemas importantes se mantienen actualizados y cuentan con medidas básicas de protección?',action:'Establecer actualización y protección mínima de equipos y sistemas.'},
{id:'CYB-04',domain:'CIBERSEGURIDAD',q:'Si mañana ocurre un ataque, pérdida de equipo o acceso indebido, ¿está claro quién debe actuar y qué hacer primero?',action:'Definir responsables y respuesta mínima ante incidentes.',critical:true},
{id:'CON-01',domain:'CONTINUIDAD',q:'¿La empresa sabe qué procesos, sistemas y proveedores no pueden quedar fuera de servicio por mucho tiempo?',action:'Identificar procesos y dependencias críticas.'},
{id:'CON-02',domain:'CONTINUIDAD',q:'¿La información crítica cuenta con respaldos realizados regularmente y protegidos?',action:'Implementar o verificar un esquema mínimo de respaldo protegido.',critical:true},
{id:'CON-03',domain:'CONTINUIDAD',q:'¿La empresa ha comprobado que realmente puede recuperar información desde sus respaldos?',action:'Ejecutar y documentar una prueba de restauración.',critical:true},
{id:'CON-04',domain:'CONTINUIDAD',q:'Si un sistema, proveedor o persona crítica deja de estar disponible, ¿existe una alternativa conocida para continuar operando?',action:'Definir contingencias para dependencias críticas.'}
];
const scale=[['0','No existe','No lo hacemos o no lo sabemos.'],['1','Informal','Se hace algunas veces y depende de las personas.'],['2','Habitual','Existe una práctica habitual, pero poco formalizada.'],['3','Gestionado','Hay responsable, práctica definida y evidencia.'],['4','Verificado','Se controla, verifica y mejora periódicamente.']];
---
<Layout title="Diagnóstico SDAI PYME | Preparación Digital" description="Diagnóstico inicial SDAI PYME para evaluar capacidades en IA, datos, privacidad, ciberseguridad y continuidad.">
<main class="assessment">
<section class="intro"><div class="container narrow"><span class="eyebrow">SDAI-PYME-001 · ASSESSMENT v1.0</span><h1>Diagnóstico de <em>Preparación Digital</em></h1><p>Primero entendemos tu contexto. Después evaluamos 20 capacidades en IA, datos, privacidad, ciberseguridad y continuidad. El resultado prioriza qué atender primero; no constituye una certificación ni determina por sí solo cumplimiento normativo.</p></div></section>
<section class="wizard-section"><div class="container narrow"><div class="progress"><div id="bar"></div></div><div class="step-meta"><span id="stepLabel">PASO 1 DE 3</span><span id="stepName">Contexto</span></div>
<form id="assessmentForm">
<div class="panel active" data-panel="context"><h2>Conozcamos tu operación.</h2><p class="hint">Estas respuestas no suman puntos. Nos permiten interpretar exposición y aplicabilidad según tu realidad.</p><div class="context-grid">
{contextQuestions.map((x,i)=><fieldset class="context-q"><legend><b>{String(i+1).padStart(2,'0')}</b>{x.label}</legend><div class="options">
{x.type==='bool'&&<><label><input required type="radio" name={x.id} value="yes"/> Sí</label><label><input required type="radio" name={x.id} value="no"/> No</label></>}
{x.type==='tri'&&<><label><input required type="radio" name={x.id} value="yes"/> Sí</label><label><input required type="radio" name={x.id} value="no"/> No</label><label><input required type="radio" name={x.id} value="unknown"/> No sé</label></>}
{x.type==='operability'&&<><label><input required type="radio" name={x.id} value="yes"/> Sí</label><label><input required type="radio" name={x.id} value="partial"/> Parcialmente</label><label><input required type="radio" name={x.id} value="no"/> No</label></>}
</div></fieldset>)}</div><button type="button" class="btn-premium next" data-next="capacity">Continuar al assessment</button></div>
<div class="panel" data-panel="capacity"><h2>20 capacidades. Una lectura ejecutiva.</h2><p class="hint">Selecciona la alternativa que mejor representa la realidad actual. No respondas pensando en cómo debería funcionar la empresa.</p><div class="scale-help">{scale.map(s=><div><b>{s[0]}</b><span><strong>{s[1]}</strong>{s[2]}</span></div>)}</div><div class="controls">
{controls.map(c=><fieldset class="control-q" data-domain={c.domain} data-id={c.id}><legend><span>{c.id}</span>{c.q}</legend><div class="score-options">{scale.map(s=><label title={s[2]}><input required type="radio" name={c.id} value={s[0]}/><b>{s[0]}</b><small>{s[1]}</small></label>)}</div><div class="evidence"><span>¿Podrías demostrar esta práctica?</span><label><input required type="radio" name={c.id+'-ev'} value="0"/> No</label><label><input required type="radio" name={c.id+'-ev'} value="0.5"/> Parcialmente</label><label><input required type="radio" name={c.id+'-ev'} value="1"/> Sí</label></div></fieldset>)}</div><div class="nav-actions"><button type="button" class="back" data-back="context">← Contexto</button><button type="button" class="btn-premium next" data-next="result">Calcular diagnóstico</button></div></div>
<div class="panel" data-panel="result"><div id="resultContent"></div><div class="nav-actions"><button type="button" class="back" data-back="capacity">← Revisar respuestas</button><a href="/#contacto" class="btn-premium">Solicitar sesión ejecutiva SDAI</a></div></div>
</form></div></section></main>
<script define:vars={{controls}}>
const form=document.getElementById('assessmentForm'),panels=[...document.querySelectorAll('.panel')],bar=document.getElementById('bar'),stepLabel=document.getElementById('stepLabel'),stepName=document.getElementById('stepName'),resultContent=document.getElementById('resultContent');
const steps={context:[1,'Contexto','33%'],capacity:[2,'Capacidades','66%'],result:[3,'Resultado','100%']};
function show(name){panels.forEach(p=>p.classList.toggle('active',p.dataset.panel===name));const s=steps[name];stepLabel.textContent='PASO '+s[0]+' DE 3';stepName.textContent=s[1];bar.style.width=s[2];window.scrollTo({top:90,behavior:'smooth'});}
function validatePanel(name){const panel=document.querySelector('[data-panel="'+name+'"]'),required=[...panel.querySelectorAll('[required]')],names=[...new Set(required.map(x=>x.name))];for(const n of names){if(!panel.querySelector('input[name="'+CSS.escape(n)+'"]:checked')){const el=panel.querySelector('input[name="'+CSS.escape(n)+'"]');el?.focus();el?.closest('fieldset')?.classList.add('missing');return false;}}panel.querySelectorAll('.missing').forEach(x=>x.classList.remove('missing'));return true;}
document.querySelectorAll('.next').forEach(btn=>btn.addEventListener('click',()=>{const current=btn.closest('.panel').dataset.panel;if(!validatePanel(current))return;if(btn.dataset.next==='result')calculate();show(btn.dataset.next);}));
document.querySelectorAll('.back').forEach(btn=>btn.addEventListener('click',()=>show(btn.dataset.back)));form.addEventListener('change',e=>e.target.closest('fieldset')?.classList.remove('missing'));
function val(name){return form.querySelector('input[name="'+CSS.escape(name)+'"]:checked')?.value;}
function exposure(){const x={IA:1,DATOS:2,PRIVACIDAD:1,CIBERSEGURIDAD:2,CONTINUIDAD:2};if(val('ai')==='yes')x.IA=3;else if(val('ai')==='unknown')x.IA=2;if(val('critical_excel')==='yes'||val('erp')==='yes')x.DATOS=3;if(val('clients')==='yes'||val('workers')==='yes'||val('cctv')==='yes')x.PRIVACIDAD=3;if(val('cloud')==='yes'||val('it_provider')==='yes'||val('ecommerce')==='yes')x.CIBERSEGURIDAD=3;if(val('offline')==='no'||val('critical_excel')==='yes'||val('erp')==='yes')x.CONTINUIDAD=3;return x;}
function calculate(){
const exp=exposure(),domains={};
const answers={};
controls.forEach(c=>{const score=Number(val(c.id)),ev=Number(val(c.id+'-ev'));answers[c.id]={score,ev};domains[c.domain]||={sum:0,count:0};domains[c.domain].sum+=score;domains[c.domain].count++;});
let total=0;Object.values(domains).forEach(d=>total+=d.sum);
const index=Math.round(total/(controls.length*4)*100),level=index<=20?['L1','Inicial']:index<=40?['L2','Básico']:index<=60?['L3','Definido']:index<=80?['L4','Gestionado']:['L5','Optimizado'];
const expLabel=n=>n===3?'ALTA':n===2?'MEDIA':'BAJA';
const avg=ids=>ids.reduce((s,id)=>s+(answers[id]?.score??4),0)/ids.length;
const noEvidence=ids=>ids.filter(id=>(answers[id]?.ev??1)<1).length;
const scenarios=[
{id:'RSK-CON-01',title:'Recuperación de información crítica',domain:'CONTINUIDAD',controls:['CON-02','CON-03'],active:val('critical_excel')==='yes'||val('erp')==='yes'||val('backups')!=='yes',action:'Asegurar el respaldo de la información crítica y demostrar que puede recuperarse mediante una prueba documentada.',why:'La operación depende de información digital cuya recuperación debe estar comprobada.'},
{id:'RSK-PRI-01',title:'Gestión de datos personales',domain:'PRIVACIDAD',controls:['PRI-01','PRI-02','PRI-03','PRI-04'],active:val('clients')==='yes'||val('workers')==='yes'||val('cctv')==='yes',action:'Identificar los datos personales tratados, su finalidad, responsables, información al titular y procedimiento para solicitudes.',why:'Clientes, trabajadores o CCTV amplían el tratamiento de datos personales que debe ser conocido y gestionado.'},
{id:'RSK-CYB-01',title:'Respuesta ante incidentes',domain:'CIBERSEGURIDAD',controls:['CYB-04'],active:true,action:'Definir responsables, contactos y primeras acciones ante pérdida de equipo, acceso indebido o incidente de seguridad.',why:'Sin una respuesta mínima definida, un incidente puede escalar mientras la empresa improvisa.'},
{id:'RSK-CON-02',title:'Dependencias y continuidad operacional',domain:'CONTINUIDAD',controls:['CON-01','CON-04'],active:val('offline')!=='yes'||val('it_provider')==='yes'||val('erp')==='yes',action:'Identificar procesos, personas, sistemas y proveedores críticos y definir alternativas básicas de continuidad.',why:'La indisponibilidad de una dependencia crítica puede detener la operación.'},
{id:'RSK-ACC-01',title:'Gobierno de información y accesos',domain:'DATOS',controls:['DAT-01','DAT-02','CYB-02'],active:val('critical_excel')==='yes'||val('erp')==='yes'||val('cloud')==='yes',action:'Inventariar la información crítica, asignar responsables y revisar cuentas, privilegios y bajas de acceso.',why:'La información crítica requiere responsables y accesos controlados.'},
{id:'RSK-IA-01',title:'Uso responsable de inteligencia artificial',domain:'IA',controls:['IA-01','IA-02','IA-03','IA-04'],active:val('ai')==='yes'||val('ai')==='unknown',action:'Identificar herramientas de IA, definir reglas de uso de información y establecer revisión humana y responsabilidad.',why:'El uso de IA sin reglas puede exponer información o introducir decisiones no revisadas.'}
].filter(r=>r.active).map(r=>{const a=avg(r.controls),missing=noEvidence(r.controls),gap=(4-a)/4,criticalZero=r.controls.some(id=>controls.find(c=>c.id===id)?.critical&&answers[id]?.score<=1);let severity=gap*exp[r.domain]+(missing/r.controls.length)*.7+(criticalZero?.55:0);let status='MEJORAR',horizon='61–90 días';if(severity>=2.25){status='ACTUAR';horizon='0–30 días';}else if(severity>=1.35){status='PRIORIZAR';horizon='31–60 días';}return{...r,avg:a,missing,severity,status,horizon};}).sort((a,b)=>b.severity-a.severity);
const top=scenarios.slice(0,5);
const domainRows=Object.entries(domains).map(([k,d])=>{const pct=Math.round(d.sum/(d.count*4)*100);return '<article class="domain-card" style="padding:18px 16px;border:1px solid rgba(148,163,184,.12);border-radius:16px;background:rgba(255,255,255,.02)"><div style="min-height:46px"><b style="display:block;font-size:.72rem;letter-spacing:.04em;margin-bottom:6px">'+k+'</b><span class="exposure '+expLabel(exp[k]).toLowerCase()+'" style="display:block;font-size:.58rem;letter-spacing:.06em;color:#94a3b8">'+expLabel(exp[k])+' EXPOSICIÓN</span></div><strong style="display:block;font-family:Sora;font-size:2rem;margin:16px 0 12px">'+pct+'<i style="font-size:.8rem;color:#64748b;font-style:normal">%</i></strong><div class="meter" style="height:4px;background:#0f172a;border-radius:9px;overflow:hidden"><i style="display:block;height:100%;width:'+pct+'%;background:linear-gradient(90deg,#2563eb,#38bdf8)"></i></div><small style="display:block;color:#64748b;font-size:.55rem;letter-spacing:.08em;margin-top:10px">PREPARACIÓN ACTUAL</small></article>';}).join('');
const priorityRows=top.map((r,i)=>'<article class="risk-card" style="display:grid;grid-template-columns:58px 1fr;border:1px solid rgba(148,163,184,.12);border-radius:18px;background:rgba(255,255,255,.018);overflow:hidden"><div class="risk-index" style="padding:24px 12px;border-right:1px solid rgba(148,163,184,.09);color:#d7a84b;font-family:Sora;font-size:.8rem;text-align:center">'+String(i+1).padStart(2,'0')+'</div><div class="risk-body" style="padding:22px 24px"><div class="risk-labels" style="display:flex;align-items:center;gap:12px;margin-bottom:13px"><span class="status '+r.status.toLowerCase()+'" style="display:inline-block;padding:5px 9px;border:1px solid rgba(215,168,75,.25);border-radius:999px;color:#d7a84b;font-size:.6rem;letter-spacing:.1em">'+r.status+'</span><span style="color:#94a3b8;font-size:.68rem">'+r.horizon+'</span></div><h3 style="font-size:1.2rem;margin:0 0 8px">'+r.title+'</h3><p style="color:#94a3b8;font-size:.88rem;margin:0 0 18px">'+r.why+'</p><div class="risk-action" style="padding:14px 16px;background:rgba(2,6,23,.55);border-radius:10px"><small style="display:block;color:#64748b;font-size:.58rem;letter-spacing:.1em;margin-bottom:6px">PRÓXIMO PASO</small><b style="display:block;font-size:.84rem;line-height:1.5">'+r.action+'</b></div><div class="risk-meta" style="display:flex;justify-content:space-between;gap:15px;margin-top:12px;color:#64748b;font-size:.64rem"><span>'+r.controls.join(' · ')+'</span><span>'+expLabel(exp[r.domain])+' EXPOSICIÓN</span></div></div></article>').join('');
const triggers=[];if(val('cctv')==='yes')triggers.push('CCTV');if(val('critical_excel')==='yes')triggers.push('Excel crítico');if(val('workers')==='yes')triggers.push('Datos de trabajadores');if(val('clients')==='yes')triggers.push('Datos de clientes');if(val('ai')==='yes')triggers.push('Uso de IA');
const interpretation=level[0]==='L1'?'Las capacidades digitales son principalmente reactivas y dependen de personas o conocimiento informal.':level[0]==='L2'?'La empresa sostiene su operación cotidiana, pero una parte relevante de sus capacidades digitales depende todavía de prácticas informales y controles no demostrables.':level[0]==='L3'?'La empresa cuenta con prácticas definidas en varias áreas, aunque aún existen capacidades que requieren mayor consistencia y evidencia.':'La empresa presenta capacidades digitales gestionadas; el foco debe estar en verificar, medir y mejorar de forma periódica.';
const first=top[0];
resultContent.innerHTML='<div class="executive-report" style="max-width:980px;margin:0 auto"><header class="report-hero"><div class="report-kicker"><span>SDAI-PYME-001</span><b>DIAGNÓSTICO EJECUTIVO</b></div><div class="report-score"><div class="score-main"><small>ÍNDICE DE PREPARACIÓN</small><strong>'+index+'<i>/100</i></strong><span>'+level[0]+' · '+level[1]+'</span></div><div class="score-copy"><small>LECTURA EJECUTIVA</small><p>'+interpretation+'</p></div></div>'+(first?'<div class="immediate"><div><small>PRIORIDAD INMEDIATA</small><h2>'+first.title+'</h2></div><p>'+first.action+'</p><span>'+first.status+' · '+first.horizon+'</span></div>':'')+'</header><section class="report-block"><div class="report-heading"><span>01</span><div><small>MAPA DE PREPARACIÓN</small><h2>¿Dónde estamos hoy?</h2></div></div><div class="domain-board" style="display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px">'+domainRows+'</div></section><section class="report-block"><div class="report-heading"><span>02</span><div><small>RUTA DE ACCIÓN</small><h2>¿Qué debemos resolver primero?</h2></div></div><p class="section-lead">Agrupamos las brechas en escenarios de riesgo para convertir el diagnóstico en decisiones concretas. El horizonte responde a exposición, capacidad y evidencia.</p><div class="priority-list" style="display:grid;gap:14px">'+priorityRows+'</div></section><section class="report-block"><div class="report-heading"><span>03</span><div><small>CONDICIONANTES</small><h2>Contexto considerado</h2></div></div><div class="context-tags" style="display:flex;gap:10px;flex-wrap:wrap;margin-left:52px">'+(triggers.length?triggers.map(t=>'<span style="display:inline-block;padding:9px 14px;border:1px solid rgba(56,189,248,.16);border-radius:999px;color:#94a3b8;background:rgba(56,189,248,.04);font-size:.72rem">'+t+'</span>').join(''):'<span style="padding:9px 14px;border:1px solid rgba(56,189,248,.16);border-radius:999px;color:#94a3b8">Sin condicionantes especiales</span>')+'</div></section><footer class="report-scope"><div><b>ALCANCE</b><p>Evaluación inicial de preparación y capacidades. No constituye certificación, auditoría legal ni determina por sí sola cumplimiento normativo.</p></div><span>SDAI Trust Framework™</span></footer></div>'
}
</script>
</Layout>
<style is:global>
.assessment{background:#020617;min-height:100vh}.narrow{max-width:1040px}.intro{padding:160px 0 55px;background:radial-gradient(circle at 80% 25%,rgba(37,99,235,.16),transparent 38%),#020617}.eyebrow{color:#38bdf8;font-size:.72rem;font-weight:800;letter-spacing:.16em}.intro h1{font-size:clamp(2.8rem,6vw,5.2rem);line-height:1.02;letter-spacing:-.05em;margin:18px 0}.intro em{font-style:normal;color:#38bdf8}.intro p,.hint,.result-note{color:#94a3b8}.scenario{display:flex;gap:16px;flex-wrap:wrap;margin-top:28px;padding:15px 18px;border:1px solid rgba(215,168,75,.2);border-radius:12px;background:rgba(215,168,75,.04)}.scenario b{color:#d7a84b}.wizard-section{padding-top:35px}.progress{height:3px;background:#0f172a}.progress div{height:100%;width:33%;background:linear-gradient(90deg,#2563eb,#38bdf8);transition:.3s}.step-meta{display:flex;justify-content:space-between;color:#64748b;font-size:.7rem;letter-spacing:.12em;margin:12px 0 40px}.panel{display:none}.panel.active{display:block}.panel>h2,#resultContent>h2{font-size:clamp(1.8rem,4vw,3rem);margin:0 0 10px}.context-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:32px 0}.context-q,.control-q{border:1px solid rgba(148,163,184,.12);border-radius:16px;background:rgba(255,255,255,.025);padding:20px}.context-q legend,.control-q legend{padding:0 8px;font-weight:650;line-height:1.5}.context-q legend b{color:#d7a84b;font-size:.68rem;margin-right:10px}.options{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.options label,.evidence label{cursor:pointer;border:1px solid rgba(148,163,184,.15);padding:8px 12px;border-radius:999px;color:#cbd5e1;font-size:.82rem}.options label:has(input:checked),.evidence label:has(input:checked){border-color:#38bdf8;color:#fff;background:rgba(56,189,248,.1)}input[type=radio]{accent-color:#38bdf8}.missing{border-color:#ef4444!important}.scale-help{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:28px 0}.scale-help>div{padding:12px;border:1px solid rgba(148,163,184,.1)