---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Contact from '../components/Contact.astro';

const servicios = [
	{ title: "Diagnóstico Ley N° 21.719", body: "Auditamos el estado actual de tu organización frente a los requisitos de la nueva ley de protección de datos personales de Chile, identificando brechas y prioridades de acción." },
	{ title: "Implementación ISO 27701", body: "Diseñamos e implementamos un Sistema de Gestión de Información de Privacidad (SGIP) certificable, extensión directa de tu SGSI ISO 27001, el estándar global más exigente en privacidad." },
	{ title: "Gobierno de Privacidad", body: "Definimos roles (DPO/Encargado de Datos), comités, flujos de aprobación y procesos internos para que la privacidad sea una función organizacional sostenible, no reactiva." },
	{ title: "Gestión de Consentimientos y Derechos ARCOP+B", body: "Implementamos mecanismos técnicos y procedimentales para gestionar consentimientos, y atender los derechos de Acceso, Rectificación, Cancelación, Oposición, Portabilidad y Bloqueo." },
	{ title: "EIPD / Evaluaciones de Impacto (DPIA)", body: "Realizamos Evaluaciones de Impacto en la Protección de Datos (EIPD/DPIA) para proyectos de alto riesgo, requisito explícito de la Ley 21.719 para tratamientos de datos sensibles." },
	{ title: "Privacidad en IA y Ecosistemas de Datos", body: "Garantizamos que tus proyectos de Inteligencia Artificial y plataformas de datos cumplan los principios de minimización, anonimización y privacidad por diseño desde el origen." }
];

const diferenciadores = [
	{ icon: "🏛️", label: "ISO 27701:2019", desc: "Única extensión de ISO 27001 dedicada a la gestión de privacidad. Certificable internacionalmente." },
	{ icon: "⚖️", label: "Ley N° 21.719", desc: "Primera ley chilena de protección de datos alineada a estándares OCDE. Vigente desde 2026." },
	{ icon: "🔗", label: "Marco Integrado", desc: "Privacidad conectada con Seguridad (ISO 27001), Datos (DAMA) e IA en un solo framework SDAI." },
	{ icon: "🇨🇱", label: "Diferenciador Chile", desc: "Pocas empresas en Chile ofrecen ISO 27701. Tu organización puede ser pionera en tu industria." }
];
---

<Layout title="Privacidad Estratégica ISO 27701 | SDAI CHILE" description="Implementamos privacidad como ventaja competitiva bajo ISO 27701 y Ley N° 21.719. El pilar que diferencia a las organizaciones chilenas en protección de datos personales.">
	<div class="grid-bg"></div>
	<main>
		<!-- Hero Section -->
		<section class="page-hero">
			<div class="glow-privacy"></div>
			<div class="container hero-content">
				<div class="badge-row">
					<span class="badge badge-iso">ISO 27701:2019</span>
					<span class="badge badge-ley">Ley N° 21.719</span>
				</div>
				<h1 class="text-gradient-privacy">Privacidad: El nuevo<br/>imperativo estratégico</h1>
				<p class="hero-subtitle">La protección de datos personales dejó de ser un trámite legal. Es la <strong>ventaja competitiva</strong> que diferencia a las organizaciones chilenas de vanguardia.</p>
				<div class="hero-ctas">
					<a href="#contacto" class="btn-privacy">Solicitar Diagnóstico ISO 27701</a>
					<a href="/politica-de-privacidad" class="btn-ghost">Ver nuestra Política (Ley 21.719) →</a>
				</div>
			</div>
		</section>

		<!-- Normative Context -->
		<section class="content-section">
			<div class="container">
				<div class="split-grid">
					<div class="text-block">
						<span class="section-label">Marco Normativo Chile</span>
						<h2>El momento es ahora</h2>
						<p>Chile entra a una nueva era de responsabilidad en el tratamiento de datos personales. Las organizaciones que actúen proactivamente construirán confianza, las que esperen enfrentarán sanciones.</p>
						<ul class="check-list">
							<li><strong>Ley N° 21.719:</strong> Protección de datos personales — moderniza y reemplaza la Ley 19.628.</li>
							<li><strong>Agencia de Protección de Datos:</strong> Nueva autoridad chilena con facultades sancionatorias.</li>
							<li><strong>ISO 27701:2019:</strong> Extensión de ISO 27001 — el estándar internacional para sistemas de gestión de privacidad.</li>
							<li><strong>GDPR como referencia:</strong> Marco europeo adoptado como modelo por la legislación chilena.</li>
						</ul>
					</div>
					<div class="glass-box highlight-box">
						<div class="iso-badge-large">
							<span class="iso-number">27701</span>
							<span class="iso-label">ISO</span>
						</div>
						<h3>¿Por qué ISO 27701 es el diferenciador?</h3>
						<p>Es la única norma internacional certificable que integra la gestión de privacidad directamente sobre el SGSI (ISO 27001). Las organizaciones certificadas demuestran privacidad por diseño, no por cumplimiento reactivo.</p>
						<div class="stat-item">
							<span class="stat-value privacy-color">Privacy by Design</span>
							<p>Principio rector de la Ley 21.719 y de la norma ISO 27701: la privacidad integrada desde el inicio, no añadida después.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Diferenciadores -->
		<section class="diferenciadores-section">
			<div class="container">
				<div class="section-header">
					<span class="section-label">Por qué SDAI Chile</span>
					<h2 class="text-gradient-privacy">Un diferenciador real en el mercado chileno</h2>
					<p>ISO 27701 es escasa en Chile. Implementarla coloca a tu organización en una categoría distinta.</p>
				</div>
				<div class="dif-grid">
					{diferenciadores.map(d => (
						<div class="dif-card glass">
							<span class="dif-icon">{d.icon}</span>
							<h3>{d.label}</h3>
							<p>{d.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Services Grid -->
		<section class="pillars-section">
			<div class="container">
				<div class="section-header">
					<span class="section-label">Nuestros Servicios</span>
					<h2 class="text-gradient-privacy">Gestión integral de privacidad</h2>
					<p>Construimos programas de privacidad sostenibles, desde el diagnóstico hasta la certificación ISO 27701.</p>
				</div>
				<div class="services-grid">
					{servicios.map(s => (
						<div class="privacy-card glass">
							<div class="privacy-card-accent"></div>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- SDAI Integration: 4 Pilares -->
		<section class="integration-section">
			<div class="container">
				<div class="glass integration-card">
					<div class="int-header">
						<span class="section-label">El Framework SDAI Completo</span>
						<h2>Privacidad conectada con los 4 pilares</h2>
						<p>La Privacidad no opera de forma aislada. En SDAI Chile, se integra con Seguridad, Data e IA para crear un sistema de confianza total para tu organización.</p>
					</div>
					<div class="pilares-conexion">
						<div class="pilar-node pilar-seguridad">
							<span class="pilar-icon">🛡️</span>
							<span class="pilar-name">Seguridad</span>
							<span class="pilar-std">ISO 27001</span>
						</div>
						<div class="conexion-linea"></div>
						<div class="pilar-node pilar-data">
							<span class="pilar-icon">📊</span>
							<span class="pilar-name">Data</span>
							<span class="pilar-std">DAMA-DMBOK2</span>
						</div>
						<div class="conexion-linea"></div>
						<div class="pilar-node pilar-ai">
							<span class="pilar-icon">🤖</span>
							<span class="pilar-name">IA</span>
							<span class="pilar-std">Agnóstica</span>
						</div>
						<div class="conexion-linea"></div>
						<div class="pilar-node pilar-privacidad pilar-active">
							<span class="pilar-icon">🔐</span>
							<span class="pilar-name">Privacidad</span>
							<span class="pilar-std">ISO 27701</span>
						</div>
					</div>
					<p class="int-footer-text">ISO 27701 es la extensión natural de ISO 27001. Si tu organización ya tiene o proyecta un SGSI, agregar privacidad no es un proyecto nuevo — es una evolución estratégica.</p>
				</div>
			</div>
		</section>

		<!-- CTA Banner -->
		<section class="cta-banner">
			<div class="container">
				<div class="glass banner-inner">
					<h2>La privacidad que no se gestiona, se convierte en riesgo</h2>
					<p>Con la Agencia de Protección de Datos operativa, el cumplimiento reactivo ya no es suficiente. Construye un programa proactivo, auditable y certificable.</p>
					<a href="#contacto" class="btn-privacy">Iniciar Programa de Privacidad ISO 27701</a>
				</div>
			</div>
		</section>

		<Contact />
	</main>
</Layout>

<style>
	.grid-bg {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image:
			linear-gradient(rgba(0, 212, 170, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 212, 170, 0.025) 1px, transparent 1px);
		background-size: 50px 50px;
		z-index: -1;
		pointer-events: none;
	}

	/* ─── Variables de color para Privacidad ─── */
	:root {
		--privacy: #00D4AA;
		--privacy-dim: rgba(0, 212, 170, 0.15);
		--privacy-glow: rgba(0, 212, 170, 0.4);
	}

	/* ─── Hero ─── */
	.page-hero {
		min-height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: 150px;
		padding-bottom: 80px;
		position: relative;
		overflow: hidden;
	}

	.glow-privacy {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, rgba(0, 212, 170, 0.12) 0%, transparent 70%);
		filter: blur(60px);
		z-index: 0;
		animation: pulseGlow 4s ease-in-out infinite;
	}

	@keyframes pulseGlow {
		0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
		50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.badge-row {
		display: flex;
		gap: 12px;
		justify-content: center;
		margin-bottom: 28px;
	}

	.badge {
		padding: 8px 16px;
		border-radius: 100px;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.5px;
	}

	.badge-iso {
		background: rgba(0, 212, 170, 0.12);
		color: var(--privacy);
		border: 1px solid rgba(0, 212, 170, 0.25);
	}

	.badge-ley {
		background: rgba(0, 163, 255, 0.1);
		color: var(--sdai-primary);
		border: 1px solid rgba(0, 163, 255, 0.2);
	}

	h1 {
		font-size: clamp(2.8rem, 7vw, 5rem);
		font-weight: 800;
		max-width: 900px;
		margin: 0 auto 28px;
		line-height: 1.1;
	}

	.text-gradient-privacy {
		background: linear-gradient(135deg, #fff 0%, var(--privacy) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		color: var(--sdai-text-dim);
		max-width: 680px;
		margin: 0 auto 40px;
		line-height: 1.7;
	}

	.hero-subtitle strong {
		color: var(--privacy);
	}

	.hero-ctas {
		display: flex;
		gap: 20px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-privacy {
		background: linear-gradient(135deg, var(--privacy) 0%, #009977 100%);
		color: #020617;
		padding: 18px 36px;
		border-radius: 100px;
		font-weight: 800;
		text-decoration: none;
		display: inline-block;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 4px 20px rgba(0, 212, 170, 0.35);
		font-size: 1rem;
		letter-spacing: 0.3px;
	}

	.btn-privacy:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 40px rgba(0, 212, 170, 0.55);
		filter: brightness(1.05);
	}

	.btn-ghost {
		color: var(--sdai-text-dim);
		text-decoration: none;
		padding: 18px 24px;
		font-weight: 600;
		transition: color 0.3s ease;
		display: inline-flex;
		align-items: center;
	}

	.btn-ghost:hover {
		color: var(--privacy);
	}

	/* ─── Content Section (split-grid) ─── */
	.content-section {
		padding: 80px 0;
	}

	.split-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: center;
	}

	.text-block h2 {
		font-size: 3rem;
		margin-bottom: 24px;
		line-height: 1.15;
	}

	.text-block p {
		color: var(--sdai-text-dim);
		font-size: 1.1rem;
		line-height: 1.7;
		margin-bottom: 32px;
	}

	.section-label {
		color: var(--privacy);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 0.9rem;
		letter-spacing: 2px;
		margin-bottom: 16px;
		display: block;
	}

	.check-list {
		list-style: none;
		padding: 0;
		margin-top: 24px;
	}

	.check-list li {
		padding: 14px 0;
		display: flex;
		align-items: flex-start;
		gap: 15px;
		font-size: 1.05rem;
		color: var(--sdai-text-dim);
		border-bottom: 1px solid rgba(255,255,255,0.04);
		line-height: 1.5;
	}

	.check-list li::before {
		content: '🔐';
		font-size: 1.1rem;
		margin-top: 2px;
		flex-shrink: 0;
	}

	.check-list li strong {
		color: #fff;
	}

	.glass-box {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 48px;
		border-radius: 32px;
	}

	.highlight-box {
		border-color: var(--privacy);
		box-shadow: 0 0 50px rgba(0, 212, 170, 0.1);
	}

	/* ISO Badge Grande */
	.iso-badge-large {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		margin-bottom: 24px;
	}

	.iso-number {
		font-family: 'Sora', sans-serif;
		font-size: 4rem;
		font-weight: 800;
		color: var(--privacy);
		line-height: 1;
		letter-spacing: -2px;
	}

	.iso-label {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--privacy);
		opacity: 0.7;
		letter-spacing: 3px;
		text-transform: uppercase;
		margin-top: -4px;
	}

	.highlight-box h3 {
		font-size: 1.6rem;
		margin-bottom: 16px;
		color: #fff;
	}

	.highlight-box p {
		color: var(--sdai-text-dim);
		line-height: 1.7;
	}

	.stat-item {
		margin-top: 32px;
		padding-top: 32px;
		border-top: 1px solid rgba(0, 212, 170, 0.15);
	}

	.stat-value {
		font-family: 'Sora', sans-serif;
		font-size: 1.4rem;
		font-weight: 800;
		display: block;
		margin-bottom: 10px;
	}

	.privacy-color {
		color: var(--privacy);
	}

	/* ─── Diferenciadores ─── */
	.diferenciadores-section {
		background: radial-gradient(circle at 50% 50%, rgba(0, 212, 170, 0.04), transparent 70%);
		padding: 80px 0;
	}

	.section-header {
		text-align: center;
		margin-bottom: 60px;
	}

	.section-header p {
		color: var(--sdai-text-dim);
		font-size: 1.1rem;
		max-width: 600px;
		margin: 16px auto 0;
		line-height: 1.6;
	}

	.section-header h2 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 800;
		margin-top: 12px;
	}

	.dif-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.dif-card {
		padding: 36px 28px;
		border-radius: 24px;
		text-align: center;
		transition: all 0.3s ease;
		border: 1px solid rgba(0, 212, 170, 0.06);
	}

	.dif-card:hover {
		border-color: rgba(0, 212, 170, 0.25);
		background: rgba(0, 212, 170, 0.03);
		transform: translateY(-4px);
		box-shadow: 0 12px 30px rgba(0, 212, 170, 0.08);
	}

	.dif-icon {
		font-size: 2.2rem;
		display: block;
		margin-bottom: 16px;
	}

	.dif-card h3 {
		font-size: 1rem;
		font-weight: 800;
		color: var(--privacy);
		margin-bottom: 12px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.dif-card p {
		font-size: 0.92rem;
		color: var(--sdai-text-dim);
		line-height: 1.6;
		margin: 0;
	}

	/* ─── Servicios Grid ─── */
	.pillars-section {
		padding: 80px 0;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.privacy-card {
		padding: 36px;
		border-radius: 24px;
		position: relative;
		overflow: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		border: 1px solid rgba(0, 212, 170, 0.06);
	}

	.privacy-card-accent {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, var(--privacy), transparent);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.privacy-card:hover .privacy-card-accent {
		opacity: 1;
	}

	.privacy-card:hover {
		border-color: rgba(0, 212, 170, 0.2);
		background: rgba(0, 212, 170, 0.02);
		transform: translateY(-4px);
		box-shadow: 0 12px 40px rgba(0, 212, 170, 0.08);
	}

	.privacy-card h3 {
		font-size: 1.2rem;
		color: #fff;
		margin-bottom: 16px;
		line-height: 1.3;
	}

	.privacy-card p {
		font-size: 0.95rem;
		color: var(--sdai-text-dim);
		line-height: 1.7;
		margin: 0;
	}

	/* ─── Integración 4 pilares ─── */
	.integration-section {
		padding: 80px 0;
	}

	.integration-card {
		padding: 80px 60px;
		border-radius: 40px;
		background: linear-gradient(135deg, rgba(0, 45, 90, 0.2), rgba(0, 212, 170, 0.04));
	}

	.int-header {
		text-align: center;
		margin-bottom: 60px;
	}

	.int-header h2 {
		font-size: 2.8rem;
		margin: 12px 0 20px;
		line-height: 1.2;
	}

	.int-header p {
		color: var(--sdai-text-dim);
		max-width: 600px;
		margin: 0 auto;
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.pilares-conexion {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		margin: 40px 0;
		flex-wrap: wrap;
	}

	.pilar-node {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 28px 32px;
		border-radius: 20px;
		background: rgba(255,255,255,0.02);
		border: 1px solid rgba(255,255,255,0.06);
		transition: all 0.3s ease;
		min-width: 120px;
	}

	.pilar-node:hover {
		transform: translateY(-4px);
	}

	.pilar-icon {
		font-size: 2rem;
	}

	.pilar-name {
		font-weight: 800;
		font-size: 1rem;
		color: #fff;
	}

	.pilar-std {
		font-size: 0.75rem;
		color: var(--sdai-text-dim);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.conexion-linea {
		height: 1px;
		width: 40px;
		background: linear-gradient(90deg, rgba(255,255,255,0.1), rgba(0, 212, 170, 0.3), rgba(255,255,255,0.1));
		flex-shrink: 0;
	}

	.pilar-active {
		border-color: var(--privacy) !important;
		background: rgba(0, 212, 170, 0.06) !important;
		box-shadow: 0 0 30px rgba(0, 212, 170, 0.15);
	}

	.pilar-active .pilar-name {
		color: var(--privacy);
	}

	.pilar-active .pilar-std {
		color: var(--privacy);
		opacity: 0.8;
	}

	.int-footer-text {
		text-align: center;
		color: var(--sdai-text-dim);
		font-size: 1rem;
		line-height: 1.7;
		max-width: 700px;
		margin: 0 auto;
		border-top: 1px solid rgba(0,212,170,0.1);
		padding-top: 40px;
	}

	/* ─── CTA Banner ─── */
	.cta-banner {
		padding: 0 0 80px;
	}

	.banner-inner {
		padding: 80px 60px;
		border-radius: 40px;
		text-align: center;
		background: linear-gradient(135deg, rgba(0, 45, 90, 0.3), rgba(0, 212, 170, 0.06));
		border-color: rgba(0, 212, 170, 0.15);
	}

	.banner-inner h2 {
		font-size: 2.4rem;
