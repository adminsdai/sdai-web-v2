// Portal SDAI v1. Base nueva; no ejecutar db push sobre sdai_db, CRM o Kanban.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PrivacyStatus {
  RECEIVED
  VERIFYING
  IN_REVIEW
  RESPONDED
  CLOSED
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  DONE
}

model User {
  id             String         @id @default(uuid()) @db.Char(36)
  email          String         @unique @db.VarChar(254)
  name           String         @db.VarChar(160)
  status         UserStatus     @default(ACTIVE)
  passwordHash   String?        @db.VarChar(255)
  createdAt      DateTime       @default(now())
  disabledAt     DateTime?
  roles          UserRole[]
  sessions       Session[]
  assignedTasks  Task[]         @relation("TaskAssignee")
  ownedAccounts  Account[]      @relation("AccountOwner")
  privacyCases   PrivacyRequest[] @relation("PrivacyAssignee")
  auditEvents    AuditEvent[]   @relation("AuditActor")
  scans          Scan[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(120)
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Char(36)
  code  String           @unique @db.VarChar(100)
  roles RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId String @db.Char(36)
  roleId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  actorId   String?  @db.Char(36)
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(100)
  outcome   String   @db.VarChar(30)
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entity, entityId, createdAt])
  @@map("audit_events")
}

model Account {
  id          String        @id @default(uuid()) @db.Char(36)
  name        String        @db.VarChar(200)
  taxId       String?       @db.VarChar(30)
  ownerId     String?       @db.Char(36)
  owner       User?         @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts    Contact[]
  deals       Deal[]
  tasks       Task[]
  createdAt   DateTime      @default(now())
  @@index([ownerId])
  @@map("accounts")
}

model Contact {
  id        String   @id @default(uuid()) @db.Char(36)
  accountId String   @db.Char(36)
  name      String   @db.VarChar(160)
  email     String?  @db.VarChar(254)
  phone     String?  @db.VarChar(40)
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])
  @@index([accountId])
  @@map("contacts")
}

model Deal {
  id        String   @id @default(uuid()) @db.Char(36)
  accountId String   @db.Char(36)
  title     String   @db.VarChar(200)
  stage     String   @db.VarChar(60)
  amountUf  Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])
  @@index([accountId, stage])
  @@map("deals")
}

model Task {
  id          String     @id @default(uuid()) @db.Char(36)
  title       String     @db.VarChar(220)
  status      TaskStatus @default(BACKLOG)
  assigneeId  String?    @db.Char(36)
  accountId   String?    @db.Char(36)
  dueAt       DateTime?
  createdAt   DateTime   @default(now())
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  account     Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  @@index([assigneeId, status])
  @@map("tasks")
}

// Solicitantes externos no son usuarios internos del portal.
model PrivacyRequest {
  id               String               @id @default(uuid()) @db.Char(36)
  requestType      String               @db.VarChar(40)
  status           PrivacyStatus        @default(RECEIVED)
  requesterName    String               @db.VarChar(160)
  requesterEmail   String               @db.VarChar(254)
  verificationHash String?              @db.Char(64)
  verifiedAt       DateTime?
  assigneeId       String?              @db.Char(36)
  receivedAt       DateTime             @default(now())
  closedAt         DateTime?
  assignee         User?                @relation("PrivacyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events           PrivacyRequestEvent[]
  @@index([status, receivedAt])
  @@map("privacy_requests")
}

model PrivacyRequestEvent {
  id        String         @id @default(uuid()) @db.Char(36)
  requestId String         @db.Char(36)
  type      String         @db.VarChar(60)
  detail    String?        @db.Text
  createdAt DateTime       @default(now())
  request   PrivacyRequest @relation(fields: [requestId], references: [id])
  @@index([requestId, createdAt])
  @@map("privacy_request_events")
}

// Evidencia separada de la sesión corporativa: el solicitante autoriza un dominio.
model Scan {
  id             String   @id @default(uuid()) @db.Char(36)
  domain         String   @db.VarChar(253)
  requesterEmail String   @db.VarChar(254)
  verifiedAt     DateTime
  policyVersion  String   @db.VarChar(40)
  consentAt      DateTime
  resultHash     String?  @db.Char(64)
  operatorId     String?  @db.Char(36)
  createdAt      DateTime @default(now())
  operator       User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  @@index([domain, createdAt])
  @@map("scans")
}
