# Compose creates portal_user and sdai_portal_dev only when its data volume is empty.
# Use distinct, strong local passwords. URL-encode special characters in DATABASE_URL.
PORTAL_DB_ROOT_PASSWORD="CHANGE_ME_ROOT"
PORTAL_DB_PASSWORD="CHANGE_ME_PORTAL"
DATABASE_URL="mysql://portal_user:CHANGE_ME_PORTAL@127.0.0.1:3308/sdai_portal_dev"
PORTAL_ORIGIN="http://127.0.0.1:3100"
PORT=3100
