# ============================================================
#  SDAI CHILE SpA — Configuración Consolidada de Seguridad (.htaccess)
#  Integración Web Principal (Astro) + Plataforma /scan
#  Cumplimiento Ley N° 21.719 — Art. 3, letra f (Principio de Seguridad)
# ============================================================

# ------------------------------------------------------------
# 1. Redireccion HTTPS — PRIMERO (necesario para que HSTS funcione)
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS (HTTP → HTTPS permanente 301)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------
# 2. Cabeceras HTTP de Seguridad (Security Headers)
#    Nota: HSTS solo se envía bajo HTTPS — redireccion forzada arriba
# ------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS: Fuerza conexiones HTTPS por 2 años + subdominios + preload list
    Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Anti-Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Anti-MIME Sniffing
    Header set X-Content-Type-Options "nosniff"
    Header always set X-Content-Type-Options "nosniff"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # XSS Protection (legacy browsers)
    Header set X-XSS-Protection "1; mode=block"
    Header always set X-XSS-Protection "1; mode=block"

    # Content Security Policy (CSP) robusto
    Header set Content-Security-Policy "upgrade-insecure-requests; default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
    Header always set Content-Security-Policy "upgrade-insecure-requests; default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
</IfModule>

# ------------------------------------------------------------
# 3. Protección de Archivos Sensibles
# ------------------------------------------------------------
<FilesMatch "\.(env|jsonl|log|sql|ini|pem|key)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a directorio lib/ directamente
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloqueo de acceso directo a librerías PHP
    RewriteRule ^lib(/.*)?$ - [F,L]
    RewriteRule ^scan/lib(/.*)?$ - [F,L]

    # Exclusión para las plataformas /scan y /crm
    RewriteCond %{REQUEST_URI} ^/scan(/.*)?$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/crm(/.*)?$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^scan\.sdaichile\.com$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^crm\.sdaichile\.com$ [NC]
    RewriteRule ^ - [L]

    # Enrutamiento PHP sin extensión
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
