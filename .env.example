# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS Y ENTORNO — SDAI CHILE (.env.example)
# ============================================================

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=desarrollo
DB_NAME=desarrollo
DB_USERNAME=desarrollador
DB_USER=desarrollador
DB_PASSWORD=dev123
DB_PASS=dev123

# Prisma / PDO Connection URL para MariaDB local en Docker
DATABASE_URL="mysql://desarrollador:dev123@localhost:3306/desarrollo"

# Contraseña de acceso al panel de administración de contactos (admin-dashboard.php)
ADMIN_PASSWORD="dev123"


# SMTP autenticado — Hostinger Email
# En producción: configurar SMTP_PASS únicamente en .env del servidor; nunca en Git.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@sdaichile.com
SMTP_PASS=
SMTP_FROM=contacto@sdaichile.com
