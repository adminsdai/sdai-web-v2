datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Mensajes de Contacto y Consentimiento Ley 21.719 (Web Principal)
model ContactMessage {
  id                  Int      @id @default(autoincrement())
  name                String   @db.VarChar(255)
  email               String   @db.VarChar(255)
  message             String   @db.Text
  status              String   @default("PENDING") @db.VarChar(50) // PENDING, CONTACTED, ARCHIVED
  consentGiven        Boolean  @default(false)
  consentText         String?  @db.Text
  policyVersion       String?  @db.VarChar(50)
  ipAddress           String?  @db.VarChar(45)
  userAgent           String?  @db.VarChar(500)
  originUrl           String?  @db.VarChar(500)
  consentTimestampUtc String?  @db.VarChar(30)
  recordHash          String?  @db.VarChar(64)
  createdAt           DateTime @default(now())

  @@map("contact_messages")
}

// 2. Usuarios Autorizados (Escáner Ley 21.719)
model AuthorizedUser {
  userId             String              @id @map("user_id") @db.VarChar(255)
  role               String              @default("admin") @db.VarChar(50)
  createdAt          DateTime            @default(now()) @map("created_at")
  consentLogs        ConsentLog[]
  passkeyCredentials PasskeyCredential[]
  identityRoles      IdentityUserRole[]
  identitySessions   IdentitySession[]
  identityAudit      IdentityAuditEvent[] @relation("IdentityAuditActor")

  @@map("authorized_users")
}

// 3. Bitácora Inmutable de Consentimiento y Auditoría (Escáner Ley 21.719)
model ConsentLog {
  id            String          @id @default(uuid()) @db.VarChar(36)
  createdAt     DateTime        @default(now()) @map("created_at")
  ipAnonymized  String          @map("ip_anonymized") @db.VarChar(255)
  userAgent     String?         @map("user_agent") @db.Text
  urlScanned    String          @map("url_scanned") @db.Text
  action        String          @default("AGREED_TO_POLICIES") @db.VarChar(50)
  userId        String?         @map("user_id") @db.VarChar(255)
  policyVersion String          @default("v1.0") @map("policy_version") @db.VarChar(20)
  user          AuthorizedUser? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@map("consent_logs")
}

// 4. Credenciales Passkeys - WebAuthn (Escáner Ley 21.719)
model PasskeyCredential {
  id           String         @id @default(uuid()) @db.VarChar(36)
  createdAt    DateTime       @default(now()) @map("created_at")
  credentialId String         @unique @map("credential_id") @db.VarChar(512)
  publicKey    String         @map("public_key") @db.Text
  counter      BigInt         @default(0)
  transports   Json?
  userId       String         @map("user_id") @db.VarChar(255)
  user         AuthorizedUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "idx_user_id")
  @@map("passkey_credentials")
}


//
// MODEL-COST-001 — Motor de Cubicación SDAI PYME
// WORKING v0.1 — 2026-09-25
// Catálogos gobernados separados de ejecuciones históricas.
//

model CostProfile {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(120)
  active      Boolean   @default(true)
  rates       CostRate[]
  activities CostActivity[]

  @@map("cost_profiles")
}

model CostRate {
  id            Int         @id @default(autoincrement())
  profileId     Int
  version       String      @db.VarChar(20)
  ufPerHour     Decimal     @db.Decimal(10, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean     @default(true)
  profile       CostProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, version])
  @@index([profileId, effectiveFrom])
  @@map("cost_rates")
}

model CostCapability {
  id          Int                     @id @default(autoincrement())
  code        String                  @unique @db.VarChar(30)
  name        String                  @db.VarChar(180)
  domain      String                  @db.VarChar(30)
  active      Boolean                 @default(true)
  activities CostActivityCapability[]
  gaps       CostGap[]

  @@map("cost_capabilities")
}

model CostActivity {
  id                 Int                     @id @default(autoincrement())
  code               String                  @unique @db.VarChar(40)
  name               String                  @db.VarChar(200)
  activityType       String                  @default("SPECIALIZED") @db.VarChar(20) // MASTER, SPECIALIZED
  front              String                  @db.VarChar(40)
  primaryProfileId   Int
  hhT1               Decimal                 @db.Decimal(8, 2)
  hhT2               Decimal                 @db.Decimal(8, 2)
  hhT3               Decimal                 @db.Decimal(8, 2)
  evidenceType       String?                 @db.VarChar(80)
  acceptanceCriteria String?                 @db.Text
  version            String                  @default("1.0") @db.VarChar(20)
  active             Boolean                 @default(true)
  primaryProfile     CostProfile             @relation(fields: [primaryProfileId], references: [id])
  capabilities       CostActivityCapability[]
  serviceActivities  CostServiceActivity[]
  executionLines     CostExecutionLine[]
  gapRequirements    CostGapActivity[]

  @@index([front])
  @@map("cost_activities")
}

model CostActivityCapability {
  activityId   Int
  capabilityId Int
  contribution String?        @db.VarChar(30) // PRIMARY, SUPPORT
  activity     CostActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  capability   CostCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([activityId, capabilityId])
  @@map("cost_activity_capabilities")
}

model CostService {
  id         Int                   @id @default(autoincrement())
  code       String                @unique @db.VarChar(30)
  name       String                @db.VarChar(180)
  version    String                @default("1.0") @db.VarChar(20)
  active     Boolean               @default(true)
  activities CostServiceActivity[]
  executions CostExecution[]

  @@map("cost_services")
}

model CostServiceActivity {
  serviceId  Int
  activityId Int
  required   Boolean      @default(true)
  service    CostService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  activity   CostActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([serviceId, activityId])
  @@map("cost_service_activities")
}

model CostExecution {
  id              String              @id @default(uuid()) @db.VarChar(36)
  serviceId       Int?
  clientRef       String?             @db.VarChar(120)
  assessmentRef   String?             @db.VarChar(120)
  cplxOrg         String              @db.VarChar(2) // T1,T2,T3
  cplxSrv         String              @db.VarChar(2) // T1,T2,T3
  catalogVersion  String              @db.VarChar(30)
  status          String              @default("DRAFT") @db.VarChar(20)
  technicalUf     Decimal?            @db.Decimal(12, 2)
  estimatedHh     Decimal?            @db.Decimal(10, 2)
  createdAt       DateTime            @default(now())
  reviewedAt      DateTime?
  reviewer        String?             @db.VarChar(120)
  service         CostService?        @relation(fields: [serviceId], references: [id])
  lines           CostExecutionLine[]

  @@index([assessmentRef])
  @@map("cost_executions")
}

model CostExecutionLine {
  id             Int           @id @default(autoincrement())
  executionId    String        @db.VarChar(36)
  activityId     Int
  profileCode    String        @db.VarChar(30)
  rateUf         Decimal       @db.Decimal(10, 2)
  estimatedHh    Decimal       @db.Decimal(8, 2)
  actualHh       Decimal?      @db.Decimal(8, 2)
  technicalUf    Decimal       @db.Decimal(12, 2)
  deviationCause String?       @db.VarChar(30)
  deviationNote  String?       @db.Text
  evidenceRef    String?       @db.VarChar(255)
  observedAt     DateTime?
  execution      CostExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  activity       CostActivity  @relation(fields: [activityId], references: [id])

  @@unique([executionId, activityId])
  @@index([activityId])
  @@map("cost_execution_lines")
}


//
// MODEL-COST-001 — Translation layer GAP → CAP → ACT
//

model CostGap {
  id              String              @id @default(uuid()) @db.VarChar(36)
  assessmentRef   String              @db.VarChar(120)
  capabilityId    Int
  currentMaturity Int
  targetMaturity  Int
  priority        String?             @db.VarChar(20)
  rationale       String?             @db.Text
  status          String              @default("OPEN") @db.VarChar(20)
  createdAt       DateTime            @default(now())
  capability      CostCapability      @relation(fields: [capabilityId], references: [id])
  requirements    CostGapActivity[]

  @@index([assessmentRef])
  @@index([capabilityId])
  @@map("cost_gaps")
}

model CostGapActivity {
  gapId       String       @db.VarChar(36)
  activityId  Int
  required    Boolean      @default(true)
  rationale   String?      @db.Text
  gap         CostGap      @relation(fields: [gapId], references: [id], onDelete: Cascade)
  activity    CostActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([gapId, activityId])
  @@map("cost_gap_activities")
}


// AUTH-001 - Identidad y RBAC Unificado SDAI
model IdentityRole {
  id          Int                      @id @default(autoincrement())
  code        String                   @unique @db.VarChar(40)
  name        String                   @db.VarChar(120)
  description String?                  @db.VarChar(255)
  active      Boolean                  @default(true)
  users       IdentityUserRole[]
  permissions IdentityRolePermission[]

  @@map("identity_roles")
}

model IdentityPermission {
  id          Int                      @id @default(autoincrement())
  code        String                   @unique @db.VarChar(80)
  description String?                  @db.VarChar(255)
  roles       IdentityRolePermission[]

  @@map("identity_permissions")
}

model IdentityUserRole {
  userId     String         @db.VarChar(255)
  roleId     Int
  assignedAt DateTime       @default(now())
  assignedBy String?        @db.VarChar(255)
  user       AuthorizedUser @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role       IdentityRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("identity_user_roles")
}

model IdentityRolePermission {
  roleId       Int
  permissionId Int
  role         IdentityRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   IdentityPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("identity_role_permissions")
}

model IdentitySession {
  id         String         @id @default(uuid()) @db.VarChar(36)
  userId     String         @db.VarChar(255)
  tokenHash  String         @unique @db.VarChar(64)
  createdAt  DateTime       @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime       @default(now())
  revokedAt  DateTime?
  ipHash     String?        @db.VarChar(64)
  userAgent  String?        @db.VarChar(500)
  user       AuthorizedUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("identity_sessions")
}

model IdentityAuditEvent {
  id          String          @id @default(uuid()) @db.VarChar(36)
  actorUserId String?         @db.VarChar(255)
  action      String          @db.VarChar(80)
  resource    String          @db.VarChar(80)
  resourceId  String?         @db.VarChar(255)
  outcome     String          @db.VarChar(20)
  metadata    Json?
  ipHash      String?         @db.VarChar(64)
  createdAt   DateTime        @default(now())
  actor       AuthorizedUser? @relation("IdentityAuditActor", fields: [actorUserId], references: [userId], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resource, createdAt])
  @@map("identity_audit_events")
}
